{
  "name": "guragiru-storefront",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && opennextjs-cloudflare build --skipNextBuild",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "cf:build": "next-on-pages",
    "cf:deploy": "wrangler pages deploy .vercel/output/static",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.11.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@types/node": "^20.14.11",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "axios": "^1.12.2",
    "axios-cache-interceptor": "^1.8.3",
    "critters": "^0.0.25",
    "jose": "^6.2.3",
    "next": "^15.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-share": "^5.2.2",
    "satori": "^0.29.0",
    "typescript": "^5.5.4"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.12.0",
    "@cloudflare/workers-types": "^5.20260705.1",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.23.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "vercel": "^48.6.0",
    "wrangler": "^4.38.1"
  },
  "packageManager": "yarn@4.5.0"
}
